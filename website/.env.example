# 로컬 개발용 예시. 이 파일을 .env.local 로 복사해 값을 채운다(.env.local 은 git 에 올라가지 않는다).
# 배포 사이트는 Vercel Project → Settings → Environment Variables 에 같은 이름으로 넣는다.

# Resend → API Keys 에서 만든 키 (Sending access 권한만)
RESEND_API_KEY=
# 문의 메일을 받을 주소
CONTACT_TO=
# 보내는 사람. 도메인을 Resend 에 인증하기 전에는 비워 두면 onboarding@resend.dev 로 보낸다
CONTACT_FROM=
