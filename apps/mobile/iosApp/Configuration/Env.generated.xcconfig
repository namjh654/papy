// 자동 생성 — 수정 금지. 원본: env/*.properties · 생성: ./gradlew generateEnvConfig
// Build Configuration 이름: Debug-<env> / Release-<env> (env = dev·staging·prod)

APP_ENV[config=*-dev] = dev
APP_DISPLAY_NAME[config=*-dev] = Papy Dev
BUNDLE_ID_SUFFIX[config=*-dev] = .dev
MARKETING_VERSION[config=*-dev] = 0.3.4
CURRENT_PROJECT_VERSION[config=*-dev] = 6

APP_ENV[config=*-staging] = staging
APP_DISPLAY_NAME[config=*-staging] = Papy Stg
BUNDLE_ID_SUFFIX[config=*-staging] = .staging
MARKETING_VERSION[config=*-staging] = 0.3.4
CURRENT_PROJECT_VERSION[config=*-staging] = 6

APP_ENV[config=*-prod] = prod
APP_DISPLAY_NAME[config=*-prod] = Papy
BUNDLE_ID_SUFFIX[config=*-prod] = 
MARKETING_VERSION[config=*-prod] = 0.3.4
CURRENT_PROJECT_VERSION[config=*-prod] = 6

// Kotlin framework 빌드 타입 (embedAndSignAppleFrameworkForXcode)
KOTLIN_FRAMEWORK_BUILD_TYPE[config=Debug-*] = debug
KOTLIN_FRAMEWORK_BUILD_TYPE[config=Release-*] = release
