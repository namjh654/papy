package __pkg__.screen.__name__

import androidx.compose.foundation.layout.Arrangement
import androidx.compose.foundation.layout.fillMaxWidth
import androidx.compose.foundation.layout.padding
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.runtime.getValue
import androidx.compose.ui.Modifier
import androidx.compose.ui.res.stringResource
import androidx.lifecycle.compose.collectAsStateWithLifecycle
import __pkg__.R
import __pkg__.component.EventEffect
import __pkg__.designsystem.component.ElsaCard
import __pkg__.designsystem.component.ElsaPagedList
import __pkg__.designsystem.component.ElsaScaffold
import __pkg__.designsystem.component.ElsaScreenHeader
import __pkg__.designsystem.theme.ElsaTheme
import __pkg__.designsystem.token.ElsaSpacing
import __pkg__.feature.__name__.__Name__Event
import __pkg__.feature.__name__.__Name__Item
import __pkg__.feature.__name__.__Name__ViewModel
import org.koin.androidx.compose.koinViewModel

/**
 * __TITLE_KO__ 목록: 큰 제목 + 회색 그룹 배경 위 무테 카드, 당겨서 새로고침, 끝에서 다음 페이지.
 * @param onBack 탭 루트면 null(뒤로가기 없음), 다른 화면 위에 열리면 뒤로가기
 */
@Composable
fun __Name__Screen(
    onItemSelected: (__Name__Item) -> Unit,
    onBack: (() -> Unit)? = null,
) {
    val viewModel: __Name__ViewModel = koinViewModel()
    val state by viewModel.uiState.collectAsStateWithLifecycle()

    EventEffect(viewModel.events) { event ->
        when (event) {
            is __Name__Event.ItemSelected -> onItemSelected(event.item)
        }
    }

    ElsaScaffold(onBack = onBack, containerColor = ElsaTheme.colors.backgroundGrouped) { padding ->
        ElsaPagedList(
            state = state.list,
            key = { it.id },
            emptyTitle = stringResource(R.string.__name___empty),
            onRefresh = viewModel::refresh,
            onLoadMore = viewModel::loadMore,
            onRetry = viewModel::load,
            onRetryLoadMore = viewModel::retryLoadMore,
            modifier = Modifier.padding(padding),
            header = {
                item(key = "header") {
                    ElsaScreenHeader(
                        title = stringResource(R.string.__name___title),
                        description = stringResource(R.string.__name___description),
                    )
                }
            },
        ) { item ->
            ElsaCard(
                modifier = Modifier.fillMaxWidth(),
                onClick = { viewModel.itemClicked(item) },
                verticalArrangement = Arrangement.spacedBy(ElsaSpacing.xxs),
            ) {
                Text(text = item.title, style = ElsaTheme.typography.subtitle)
                item.subtitle?.let {
                    Text(text = it, style = ElsaTheme.typography.bodySmall, color = ElsaTheme.colors.onSurfaceVariant)
                }
            }
        }
    }
}
