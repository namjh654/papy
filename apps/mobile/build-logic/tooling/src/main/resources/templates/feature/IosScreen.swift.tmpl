import SwiftUI
import Core

/// __TITLE_KO__ 목록: 큰 제목 + 회색 그룹 배경 위 무테 카드, 당겨서 새로고침, 끝에서 다음 페이지.
struct __Name__Screen: View {

    let onItemSelected: (__Name__Item) -> Void

    @StateObject private var model = SharedViewModel(
        IOSAppGraph.shared.__name__ViewModel(),
        state: \.uiState
    )

    var body: some View {
        ElsaPagedList(
            state: model.state.list,
            id: \.id,
            emptyTitle: String(localized: "__name___empty"),
            onRefresh: {
                model.viewModel.refresh()
                await model.waitUntil { !$0.list.isRefreshing }
            },
            onLoadMore: { model.viewModel.loadMore() },
            onRetry: { model.viewModel.load() },
            onRetryLoadMore: { model.viewModel.retryLoadMore() }
        ) {
            ElsaScreenHeader(
                title: String(localized: "__name___title"),
                description: String(localized: "__name___description")
            )
        } row: { item in
            Button {
                model.viewModel.itemClicked(item: item)
            } label: {
                ElsaCard(spacing: ElsaSpacing.xxs) {
                    Text(item.title)
                        .elsaFont(ElsaFont.subtitle)
                    if let subtitle = item.subtitle {
                        Text(subtitle)
                            .elsaFont(ElsaFont.bodySmall)
                            .foregroundStyle(ElsaColor.onSurfaceVariant)
                    }
                }
            }
            .buttonStyle(ElsaPressableButtonStyle())
        }
        .elsaScreenBackground(grouped: true)
        .navigationBarTitleDisplayMode(.inline)
        .task {
            await observeEvents()
        }
    }
}


// MARK: - Event Observation

private extension __Name__Screen {

    func observeEvents() async {
        for await event in model.viewModel.events {
            switch onEnum(of: event) {
            case .itemSelected(let selected):
                onItemSelected(selected.item)
            }
        }
    }
}
