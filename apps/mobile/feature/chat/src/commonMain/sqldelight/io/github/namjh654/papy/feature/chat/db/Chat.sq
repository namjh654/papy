-- 메시지 로컬 DB(DEC-130). 화면에 바로 보일 것만 둔다 — 원본은 서버.
-- payload 는 API 모델 JSON(AppJson): 서버 필드가 늘어도 테이블은 그대로, 검색·정렬에 쓰는 값만 열로 뺀다.

-- 대화 목록 첫 페이지(다시 켜면 바로 보이고, 오프라인이어도 보인다)
CREATE TABLE conversation (
    id TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    payload TEXT NOT NULL
);

-- 대화방마다 최근 메시지(최대 ChatCache.KEEP_MESSAGES 개)
CREATE TABLE message (
    id TEXT NOT NULL PRIMARY KEY,
    conversation_id TEXT NOT NULL,
    sent_at INTEGER NOT NULL,
    payload TEXT NOT NULL
);

CREATE INDEX message_by_conversation ON message(conversation_id, sent_at);

-- 아직 서버에 가지 않은 글 메시지(앱을 꺼도 남고, 다시 열거나 연결되면 보낸다)
CREATE TABLE outbox (
    client_id TEXT NOT NULL PRIMARY KEY,
    conversation_id TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    payload TEXT NOT NULL
);

conversations:
SELECT payload FROM conversation ORDER BY position;

insertConversation:
INSERT OR REPLACE INTO conversation(id, position, payload) VALUES (?, ?, ?);

deleteConversations:
DELETE FROM conversation;

latestMessages:
SELECT payload FROM (
    SELECT payload, sent_at FROM message WHERE conversation_id = :conversationId ORDER BY sent_at DESC LIMIT :limit
) ORDER BY sent_at;

upsertMessage:
INSERT OR REPLACE INTO message(id, conversation_id, sent_at, payload) VALUES (?, ?, ?, ?);

trimMessages:
DELETE FROM message WHERE conversation_id = :conversationId AND id NOT IN (
    SELECT id FROM message WHERE conversation_id = :conversationId ORDER BY sent_at DESC LIMIT :keep
);

deleteMessages:
DELETE FROM message;

outbox:
SELECT payload FROM outbox WHERE conversation_id = ? ORDER BY created_at;

insertOutbox:
INSERT OR REPLACE INTO outbox(client_id, conversation_id, created_at, payload) VALUES (?, ?, ?, ?);

deleteOutbox:
DELETE FROM outbox WHERE client_id = ?;

deleteAllOutbox:
DELETE FROM outbox;
