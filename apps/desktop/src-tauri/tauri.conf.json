{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Papy",
  "version": "0.4.0",
  "identifier": "io.github.namjh654.papy",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Papy",
        "width": 1200,
        "height": 800,
        "label": "main",
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; worker-src 'self' blob:; frame-src 'self'; connect-src 'self' ipc: http://ipc.localhost blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Nam Jeong Hyeok",
    "copyright": "© 2026 Nam Jeong Hyeok. PolyForm Noncommercial 1.0.0.",
    "category": "Productivity",
    "shortDescription": "Offline-first PDF/HWPX document viewer",
    "longDescription": "Papy (페이피) is a free, offline-first, source-available document viewer focused on PDF and Korean HWP/HWPX documents.",
    "homepage": "https://github.com/namjh654/papy",
    "license": "PolyForm-Noncommercial-1.0.0",
    "macOS": {
      "minimumSystemVersion": "10.13",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "ko-KR",
          "en-US"
        ]
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      },
      "rpm": {
        "release": "1"
      }
    },
    "resources": {
      "resources/pdfium/": "pdfium/",
      "resources/fonts/": "fonts/",
      "resources/licenses/": "licenses/"
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF",
        "description": "PDF document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "hwp"
        ],
        "name": "HWP",
        "description": "HWP document",
        "role": "Editor",
        "mimeType": "application/x-hwp"
      },
      {
        "ext": [
          "hwpx"
        ],
        "name": "HWPX",
        "description": "HWPX document",
        "role": "Editor",
        "mimeType": "application/hwp+zip"
      },
      {
        "ext": [
          "docx"
        ],
        "name": "DOCX",
        "description": "Word document",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "ext": [
          "doc"
        ],
        "name": "DOC",
        "description": "Word 97-2003 document",
        "role": "Viewer",
        "mimeType": "application/msword"
      }
    ]
  }
}
