+    /// [Papy] 본문 문단의 각주·미주 컨트롤을 표 칸 문단의 `char_offset` 자리로 옮긴다.
+    ///
+    /// 각주 편집 함수가 본문 문단만 받으므로, 본문에서 만들고 글자를 채운 뒤 칸으로 옮긴다.
+    /// 반환: 칸 문단 안 컨트롤 번호.
+    pub fn move_note_into_cell_native(
+        &mut self,
+        section_idx: usize,
+        para_idx: usize,
+        control_idx: usize,
+        table_para_idx: usize,
+        table_control_idx: usize,
+        cell_idx: usize,
+        cell_para_idx: usize,
+        char_offset: usize,
+    ) -> Result<usize, HwpError> {
+        let note = self
+            .document
+            .sections
+            .get(section_idx)
+            .and_then(|s| s.paragraphs.get(para_idx))
+            .and_then(|p| p.controls.get(control_idx))
+            .filter(|c| matches!(c, Control::Footnote(_) | Control::Endnote(_)))
+            .cloned()
+            .ok_or_else(|| HwpError::RenderError("옮길 각주가 없습니다".to_string()))?;
+        // 표 번호는 본문 각주를 지운 뒤의 번호다(같은 문단이면 지우기 전 번호가 다를 수 있다).
+        self.delete_footnote_native(section_idx, para_idx, control_idx)?;
+        let insert_idx = {
+            let paragraph = self.get_cell_paragraph_mut(
+                section_idx,
+                table_para_idx,
+                table_control_idx,
+                cell_idx,
+                cell_para_idx,
+            )?;
+            let char_offset = char_offset.min(paragraph.text.chars().count());
+            let positions = crate::document_core::helpers::find_control_text_positions(paragraph);
+            let insert_idx = positions
+                .iter()
+                .position(|&pos| pos > char_offset)
+                .unwrap_or(paragraph.controls.len());
+            paragraph.align_ctrl_data_records();
+            paragraph.controls.insert(insert_idx, note);
+            paragraph.ctrl_data_records.insert(insert_idx, None);
+            paragraph.shift_for_inline_control_insert(insert_idx, char_offset);
+            paragraph.char_count += 8;
+            paragraph.control_mask |= 1u32 << 0x0011;
+            paragraph.has_para_text = true;
+            insert_idx
+        };
+        self.document.sections[section_idx].raw_stream = None;
+        self.mark_cell_control_dirty(section_idx, table_para_idx, table_control_idx);
+        self.reflow_cell_paragraph_after_text_edit(
+            section_idx,
+            table_para_idx,
+            table_control_idx,
+            cell_idx,
+            cell_para_idx,
+            char_offset,
+        );
+        self.recalculate_cell_paragraph_vpos_native(
+            section_idx,
+            table_para_idx,
+            table_control_idx,
+            cell_idx,
+            cell_para_idx,
+            None,
+        );
+        self.mark_table_text_reflowed_after_edit(section_idx, table_para_idx, table_control_idx)?;
+        Self::renumber_notes_separately(&mut self.document.sections[section_idx].paragraphs);
+        self.mark_section_dirty(section_idx);
+        self.recompose_section(section_idx);
+        self.paginate_if_needed();
+        self.invalidate_page_tree_cache();
+        Ok(insert_idx)
+    }
+
+    /// [Papy] 각주와 미주를 따로 1부터 번호 매긴다(본문 → 표 칸 → 글상자 순서, 문서 순서).
+    fn renumber_notes_separately(paragraphs: &mut [Paragraph]) {
+        fn visit(controls: &mut [Control], foot: &mut u16, end: &mut u16) {
+            for ctrl in controls {
+                match ctrl {
+                    Control::Footnote(note) => {
+                        note.number = *foot;
+                        *foot += 1;
+                    }
+                    Control::Endnote(note) => {
+                        note.number = *end;
+                        *end += 1;
+                    }
+                    Control::Table(table) => {
+                        for cell in &mut table.cells {
+                            for para in &mut cell.paragraphs {
+                                visit(&mut para.controls, foot, end);
+                            }
+                        }
+                    }
+                    Control::Shape(shape) => {
+                        if let Some(text_box) =
+                            shape.drawing_mut().and_then(|d| d.text_box.as_mut())
+                        {
+                            for para in &mut text_box.paragraphs {
+                                visit(&mut para.controls, foot, end);
+                            }
+                        }
+                    }
+                    _ => {}
+                }
+            }
+        }
+        let (mut foot, mut end) = (1u16, 1u16);
+        for para in paragraphs {
+            visit(&mut para.controls, &mut foot, &mut end);
+        }
+    }
