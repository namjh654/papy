+    /// [Papy] 구역의 본문 표마다 칸 문단의 줄을 칸 너비로 다시 나누고 쪽을 다시 짠다.
+    ///
+    /// HTML 붙여넣기로 만든 표는 칸 문단마다 한 줄로만 잡혀 있어, 칸보다 긴 글은 행 높이가 늘지 않고 잘린다
+    /// (DOCX·DOC 변환). 붙여넣은 뒤 한 번 부른다. 칸 안 겹친 표는 다시 나누지 않는다.
+    pub fn reflow_table_cells_native(&mut self, section_idx: usize) -> Result<(), HwpError> {
+        let paragraph_count = self
+            .document
+            .sections
+            .get(section_idx)
+            .ok_or_else(|| HwpError::RenderError(format!("구역 인덱스 {} 범위 초과", section_idx)))?
+            .paragraphs
+            .len();
+        for para_idx in 0..paragraph_count {
+            let tables: Vec<(usize, Vec<(usize, usize)>)> = self.document.sections[section_idx]
+                .paragraphs[para_idx]
+                .controls
+                .iter()
+                .enumerate()
+                .filter_map(|(control_idx, control)| match control {
+                    Control::Table(table) => Some((
+                        control_idx,
+                        table
+                            .cells
+                            .iter()
+                            .enumerate()
+                            .flat_map(|(cell_idx, cell)| {
+                                (0..cell.paragraphs.len()).map(move |p| (cell_idx, p))
+                            })
+                            .collect(),
+                    )),
+                    _ => None,
+                })
+                .collect();
+            for (control_idx, cells) in tables {
+                for (cell_idx, cell_para_idx) in cells {
+                    self.reflow_cell_paragraph(
+                        section_idx,
+                        para_idx,
+                        control_idx,
+                        cell_idx,
+                        cell_para_idx,
+                    );
+                }
+                self.mark_cell_control_dirty(section_idx, para_idx, control_idx);
+                self.mark_table_text_reflowed_after_edit(section_idx, para_idx, control_idx)?;
+            }
+        }
+        self.document.sections[section_idx].raw_stream = None;
+        self.mark_section_dirty(section_idx);
+        self.recompose_section(section_idx);
+        self.paginate_if_needed();
+        self.invalidate_page_tree_cache();
+        Ok(())
+    }
+
