+thread_local! {
+    /// [papy] 줄 채움이 쓰는 문단 탭 정지: (위치 px·단 기준, 종류) 와 줄 시작 위치(첫 줄, 나머지 줄, 단 기준 px).
+    static PARA_TABS: std::cell::RefCell<Option<(Vec<(f64, u8)>, f64, f64)>> =
+        const { std::cell::RefCell::new(None) };
+}
+
+/// [papy] 문단 탭 정지를 줄 채움에 알린다. 돌려받은 값이 사라질 때 앞 값으로 되돌린다.
+/// 종전 줄 채움은 기본 등간격 탭만 써서, 탭 정지로 보기를 나란히 둔 줄을 다시 나누면 넘쳐 접혔다
+/// (그리기는 탭 정지를 쓴다).
+struct ParaTabsGuard(Option<(Vec<(f64, u8)>, f64, f64)>);
+
+impl Drop for ParaTabsGuard {
+    fn drop(&mut self) {
+        let previous = self.0.take();
+        PARA_TABS.with(|tabs| *tabs.borrow_mut() = previous);
+    }
+}
+
+fn set_para_tabs(style: Option<&ResolvedParaStyle>) -> ParaTabsGuard {
+    let value = style.filter(|s| !s.tab_stops.is_empty()).map(|s| {
+        let stops = s.tab_stops.iter().map(|t| (t.position, t.tab_type)).collect();
+        (
+            stops,
+            s.margin_left + s.indent.max(0.0),
+            s.margin_left + (-s.indent).max(0.0),
+        )
+    });
+    ParaTabsGuard(PARA_TABS.with(|tabs| tabs.replace(value)))
+}
+
+/// [papy] 줄 시작에서 `lw_px` 만큼 온 자리의 다음 왼쪽 탭 정지(줄 시작 기준 px). 다음 정지가 왼쪽 탭이 아니거나
+/// 정지가 없으면 `None`(기본 등간격 탭).
+fn custom_next_tab_px(lw_px: f64, first_line: bool) -> Option<f64> {
+    PARA_TABS.with(|tabs| {
+        let tabs = tabs.borrow();
+        let (stops, first, rest) = tabs.as_ref()?;
+        let origin = if first_line { *first } else { *rest };
+        let abs = origin + lw_px;
+        let (position, kind) = stops.iter().copied().find(|(p, _)| *p > abs + 0.5)?;
+        (kind == 0).then_some(position - origin)
+    })
+}
