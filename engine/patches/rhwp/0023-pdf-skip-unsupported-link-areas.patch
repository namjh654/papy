                             || run.display_or_text().chars().count() != count
                         {
-                            return Err(HwpError::RenderError("회전·세로쓰기·표시값 치환 링크의 출력 영역은 아직 지원하지 않습니다".into()));
+                            // [Papy] 영역을 만들 수 없는 링크 글자는 건너뛴다. 오류로 끝내면 이런 링크가
+                            // 하나만 있어도 문서 전체의 PDF 내보내기가 실패한다(링크 누름 영역만 빠진다).
+                            continue;
                         }
