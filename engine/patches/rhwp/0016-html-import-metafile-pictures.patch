Papy 패치: HTML 붙여넣기 그림에서 BMP·WMF·EMF 를 알아보고 메타파일은 wmf·emf 확장자로 둔다.

rhwp v0.8.7(1a76570e).
data: URI 그림의 형식을 PNG·JPEG·GIF 만 알아봐 그 밖은 확장자가 octet-stream 인 그림 자료가 되어 HWP·HWPX 로 저장하면
한글이 그리지 못했다. 한글 → DOCX → 다시 열기에서 WMF 그림(HWP 3 에서 바꾼 문서 등)이 빠졌다.

--- a/src/document_core/helpers.rs	2026-11-09 08:45:59
+++ b/src/document_core/helpers.rs	2026-11-09 08:46:13
@@ -319,6 +319,13 @@
         "image/jpeg"
     } else if data.len() >= 6 && (data.starts_with(b"GIF87a") || data.starts_with(b"GIF89a")) {
         "image/gif"
+    } else if data.len() >= 2 && data.starts_with(b"BM") {
+        // [Papy] BMP·WMF·EMF(DOCX·DOC 변환 그림, 패치 0016)
+        "image/bmp"
+    } else if data.starts_with(&[0xD7, 0xCD, 0xC6, 0x9A]) || data.starts_with(&[0x01, 0x00, 0x09, 0x00]) {
+        "image/x-wmf"
+    } else if data.len() >= 44 && data.starts_with(&[0x01, 0x00, 0x00, 0x00]) && &data[40..44] == b" EMF" {
+        "image/x-emf"
     } else {
         "application/octet-stream"
     }
