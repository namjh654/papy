+/// [Papy] svg2pdf 는 쪽 그림(Form XObject)을 1×1 로 줄이는 `/Matrix [1/w 0 0 1/h 0 0]` 로 만들고, 쪽 내용이
+/// `w h cm` 으로 다시 키운다. 그리는 결과는 같지만 PDFium(Chrome 등)은 이렇게 아주 작은 배율 안의 글자를
+/// 글 꺼내기·찾기·복사에서 빠뜨린다. 같은 길이로 덮어써(xref 위치 그대로) 배율을 `0.75`(px → pt)로,
+/// 쪽 내용은 `1 0 0 1 0 0 cm` 으로 바꾼다. 같은 크기 쪽 수만큼 정확히 찾았을 때만 바꾼다.
+#[cfg(not(target_arch = "wasm32"))]
+fn normalize_page_xobject_scale(pdf: &mut [u8], sizes: &[(f32, f32, f32, f32)]) {
+    fn find_all(hay: &[u8], needle: &[u8]) -> Vec<usize> {
+        let mut out = Vec::new();
+        if needle.is_empty() || hay.len() < needle.len() {
+            return out;
+        }
+        let mut i = 0;
+        while i + needle.len() <= hay.len() {
+            if &hay[i..i + needle.len()] == needle {
+                out.push(i);
+                i += needle.len();
+            } else {
+                i += 1;
+            }
+        }
+        out
+    }
+    fn padded(new: &[u8], len: usize, close: &[u8]) -> Option<Vec<u8>> {
+        if new.len() + close.len() > len {
+            return None;
+        }
+        let mut v = new.to_vec();
+        v.resize(len - close.len(), b' ');
+        v.extend_from_slice(close);
+        Some(v)
+    }
+    let mut groups: Vec<((u32, u32, u32, u32), usize)> = Vec::new();
+    for &(sw, sh, pw, ph) in sizes {
+        let key = (sw.to_bits(), sh.to_bits(), pw.to_bits(), ph.to_bits());
+        match groups.iter_mut().find(|(k, _)| *k == key) {
+            Some((_, n)) => *n += 1,
+            None => groups.push((key, 1)),
+        }
+    }
+    for ((sw, sh, pw, ph), count) in groups {
+        let (sw, sh, pw, ph) = (
+            f32::from_bits(sw),
+            f32::from_bits(sh),
+            f32::from_bits(pw),
+            f32::from_bits(ph),
+        );
+        // svg2pdf·pdf_writer 와 같은 방식으로 숫자를 적어 찾을 글을 만든다.
+        let mut probe = pdf_writer::Chunk::new();
+        probe
+            .indirect(pdf_writer::Ref::new(1))
+            .array()
+            .items([1.0 / sw, 0.0, 0.0, 1.0 / sh, 0.0, 0.0]);
+        let probe = probe.as_bytes();
+        let (Some(a), Some(b)) = (
+            probe.iter().position(|&c| c == b'['),
+            probe.iter().position(|&c| c == b']'),
+        ) else {
+            continue;
+        };
+        let mut matrix = b"/Matrix ".to_vec();
+        matrix.extend_from_slice(&probe[a..=b]);
+        let mut cm = pdf_writer::Content::new();
+        cm.transform([pw, 0.0, 0.0, ph, 0.0, 0.0]);
+        cm.x_object(pdf_writer::Name(b"S1"));
+        let cm = cm.finish();
+        let matrix_at = find_all(pdf, &matrix);
+        let cm_at = find_all(pdf, &cm);
+        if matrix_at.len() != count || cm_at.len() != count {
+            continue;
+        }
+        let new_matrix = padded(b"/Matrix [0.75 0 0 0.75 0 0", matrix.len(), b"]");
+        let new_cm = padded(b"1 0 0 1 0 0 cm", cm.len(), b"\n/S1 Do");
+        let (Some(new_matrix), Some(new_cm)) = (new_matrix, new_cm) else {
+            continue;
+        };
+        for i in matrix_at {
+            pdf[i..i + new_matrix.len()].copy_from_slice(&new_matrix);
+        }
+        for i in cm_at {
+            pdf[i..i + new_cm.len()].copy_from_slice(&new_cm);
+        }
+    }
+}
