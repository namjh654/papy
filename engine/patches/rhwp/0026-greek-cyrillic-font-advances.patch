+        return None;
+    }
+    let widths: &[u16] = match (metric.name, metric.em_size, metric.bold, metric.italic) {
+        ("Times New Roman", 2048, false, false) => &FACE_0,
+        ("Times New Roman", 2048, true, false) => &FACE_1,
+        ("Times New Roman", 2048, false, true) => &FACE_2,
+        ("Times New Roman", 2048, true, true) => &FACE_3,
+        ("Arial", 2048, false, false) => &FACE_4,
+        ("Arial", 2048, true, false) => &FACE_5,
+        ("Arial", 2048, false, true) => &FACE_6,
+        ("Arial", 2048, true, true) => &FACE_7,
+        ("Courier New", 2048, false, false) => &FACE_8,
+        ("Courier New", 2048, true, false) => &FACE_9,
+        ("Courier New", 2048, false, true) => &FACE_10,
+        ("Courier New", 2048, true, true) => &FACE_11,
+        ("Verdana", 2048, false, false) => &FACE_12,
+        ("Verdana", 2048, true, false) => &FACE_13,
+        ("Verdana", 2048, false, true) => &FACE_14,
+        ("Verdana", 2048, true, true) => &FACE_15,
+        ("Tahoma", 2048, false, false) => &FACE_16,
+        ("Tahoma", 2048, true, false) => &FACE_17,
+        ("Georgia", 2048, false, false) => &FACE_18,
