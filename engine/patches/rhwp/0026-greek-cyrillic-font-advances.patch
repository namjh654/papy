+pub(super) fn has_glyph(metric: &FontMetric, ch: char) -> Option<bool> {
+    entry(metric, ch).map(|width| width > 0)
+}
+
+pub(super) fn width(metric: &FontMetric, ch: char) -> Option<u16> {
+    entry(metric, ch).filter(|width| *width > 0)
+}
