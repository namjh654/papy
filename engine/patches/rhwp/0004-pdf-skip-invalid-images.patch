+/// [Papy] 읽을 수 없는 PNG·JPEG 를 빼는 리졸버. svg2pdf 는 그림 하나를 못 읽으면 문서 전체를
+/// `InvalidImage` 로 실패시킨다(끝이 잘린 PNG 등). 그런 쪽만 이것으로 다시 파싱해 그림을 뺀다.
+#[cfg(not(target_arch = "wasm32"))]
+fn pdf_image_href_resolver_dropping_invalid() -> usvg::ImageHrefResolver<'static> {
+    let base = pdf_image_href_resolver();
+    usvg::ImageHrefResolver {
+        resolve_data: Box::new(move |mime, data, opts| {
+            if matches!(mime, "image/png" | "image/jpeg" | "image/jpg")
+                && image::load_from_memory(&data).is_err()
+            {
+                eprintln!("경고: PDF 변환 중 읽을 수 없는 그림({mime})을 뺍니다.");
+                return None;
+            }
+            (base.resolve_data)(mime, data, opts)
+        }),
+        resolve_string: usvg::ImageHrefResolver::default_string_resolver(),
+    }
+}
