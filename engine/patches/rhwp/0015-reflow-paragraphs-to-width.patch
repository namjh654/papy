     /// 컨트롤 번호도 같은 이유로 민다. 새 컨트롤이 `controls[control_idx]` 에 들어가면 그
     /// 자리부터 뒤 컨트롤의 번호가 1씩 커진다. 누름틀 범위가 옛 번호에 남으면 앞에 넣은
     /// 개체를 가리켜, 누름틀이 조회와 저장에서 사라진다.
+    /// [Papy] 글자 위치 `char_offset` 에 인라인 컨트롤(도형·그림·표 등, 한 칸)을 넣는다. 넣은 컨트롤 번호를 돌려준다.
+    ///
+    /// 본문에서 만든 개체를 칸·머리말·글상자 문단으로 옮길 때 쓴다(DOCX·DOC 변환, 패치 0015).
+    pub fn insert_inline_control(
+        &mut self,
+        char_offset: usize,
+        control: crate::model::control::Control,
+    ) -> usize {
+        let char_offset = char_offset.min(self.text.chars().count());
+        let positions = self.control_text_positions();
+        let index = positions
+            .iter()
+            .position(|&pos| pos > char_offset)
+            .unwrap_or(self.controls.len());
+        self.align_ctrl_data_records();
+        self.controls.insert(index, control);
+        self.ctrl_data_records.insert(index, None);
+        self.shift_for_inline_control_insert(index, char_offset);
+        self.char_count += 8;
+        self.has_para_text = true;
+        index
+    }
+
