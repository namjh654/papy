+    /// [Papy] 문단들의 줄을 너비 `width`(HWPUNIT, 문단 여백 빼기 전)로 다시 나눈다. 칸 안 표·글상자 안 문단도
+    /// 그 칸(글상자) 너비로 다시 나눈다.
+    ///
+    /// 본문에 붙여넣은 문단을 캡션·글상자·각주로 옮기면 줄이 본문 너비로 잡혀 있어 글이 상자 밖으로 나간다
+    /// (DOCX·DOC 변환). 옮긴 문단에 한 번 부른다(패치 0015).
+    pub fn reflow_paragraphs_to_width(&self, paragraphs: &mut [Paragraph], width: u32) {
+        use crate::renderer::hwpunit_to_px;
+        let styles = self.resolve_render_styles();
+        let dpi = self.dpi;
+        fn walk(
+            paragraphs: &mut [Paragraph],
+            width: u32,
+            styles: &ResolvedStyleSet,
+            dpi: f64,
+            depth: usize,
+        ) {
+            if depth > 16 {
+                return;
+            }
+            let width_px = hwpunit_to_px(width as i32, dpi);
+            for para in paragraphs.iter_mut() {
+                for control in &mut para.controls {
+                    match control {
+                        Control::Table(table) => {
+                            for cell in &mut table.cells {
+                                let padding = cell.padding.left.max(0) as u32
+                                    + cell.padding.right.max(0) as u32;
+                                let room = cell.width.saturating_sub(padding);
+                                walk(&mut cell.paragraphs, room, styles, dpi, depth + 1);
+                            }
+                        }
+                        Control::Shape(shape) => {
+                            let room = shape.common().width;
+                            if let Some(text_box) =
+                                super::super::helpers::get_textbox_from_shape_mut(shape)
+                            {
+                                let padding = text_box.margin_left.max(0) as u32
+                                    + text_box.margin_right.max(0) as u32;
+                                walk(
+                                    &mut text_box.paragraphs,
+                                    room.saturating_sub(padding),
+                                    styles,
+                                    dpi,
+                                    depth + 1,
+                                );
+                            }
+                        }
+                        _ => {}
+                    }
+                }
+                let style = styles.para_styles.get(para.para_shape_id as usize);
+                let margin = style.map_or(0.0, |s| s.margin_left + s.margin_right);
+                let room = (width_px - margin).max(0.0);
+                reflow_line_segs(para, ParagraphBox::content_width_px(room, dpi), styles, dpi);
+            }
+        }
+        walk(paragraphs, width, &styles, dpi, 0);
+    }
+
