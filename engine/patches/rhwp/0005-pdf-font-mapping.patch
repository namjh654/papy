+/// [Papy] usvg 기본 글꼴 고르기는 글 조각마다 글꼴 DB 전체를 훑는다(`Database::query`).
+/// 같은 글꼴 지정은 같은 답이 나오므로 내보내기 한 번 동안 기억한다.
+#[cfg(not(target_arch = "wasm32"))]
+fn cached_font_selector() -> usvg::FontSelectionFn<'static> {
+    use std::collections::HashMap;
+    use std::sync::Mutex;
+    let inner = usvg::FontResolver::default_font_selector();
+    let cache: Mutex<HashMap<usvg::Font, Option<usvg::fontdb::ID>>> = Mutex::new(HashMap::new());
+    Box::new(move |font, db| {
+        if let Some(hit) = cache.lock().ok().and_then(|c| c.get(font).copied()) {
+            return hit;
+        }
+        let found = inner(font, db);
+        if let Ok(mut c) = cache.lock() {
+            c.insert(font.clone(), found);
+        }
+        found
+    })
+}
+
+/// [Papy] 내보내기마다 시스템 글꼴을 다시 훑지 않도록 마지막 글꼴 DB 를 옵션별로 둔다.
 #[cfg(not(target_arch = "wasm32"))]
+fn shared_fontdb(options: &PdfExportOptions) -> std::sync::Arc<usvg::fontdb::Database> {
+    use std::sync::{Arc, Mutex};
+    static CACHE: Mutex<Option<(PdfExportOptions, Arc<usvg::fontdb::Database>)>> =
+        Mutex::new(None);
+    let mut cache = CACHE.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
+    if let Some((key, db)) = cache.as_ref() {
+        if key == options {
+            return db.clone();
+        }
+    }
+    let db = Arc::new(create_fontdb(options));
+    *cache = Some((options.clone(), db.clone()));
+    db
+}
