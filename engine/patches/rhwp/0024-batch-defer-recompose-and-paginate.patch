+    pub(crate) fn recompose_after_object_edit(&mut self, section_idx: usize, para_idx: usize) {
+        let in_range = self
+            .composed
+            .get(section_idx)
+            .is_some_and(|composed| para_idx < composed.len())
+            && self
+                .document
+                .sections
+                .get(section_idx)
+                .is_some_and(|section| para_idx < section.paragraphs.len());
+        if !self.batch_mode || !in_range {
+            self.recompose_section(section_idx);
+            return;
+        }
+        self.recompose_paragraph(section_idx, para_idx);
+        if section_idx < self.dirty_paragraphs.len() {
+            self.dirty_paragraphs[section_idx] = None;
+        }
+        if !self.batch_recompose_sections.contains(&section_idx) {
+            self.batch_recompose_sections.push(section_idx);
+        }
+    }
